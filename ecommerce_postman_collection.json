{
  "info": {
    "_postman_id": "ecom-microservices-collection-v1",
    "name": "E-Commerce Microservices API",
    "description": "Complete Postman collection for the E-Commerce Backend Microservices (Gateway, Auth, Product, Cart, Order).\n\nBase URL defaults to API Gateway (http://localhost:3000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "sellerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health Checks",
      "item": [
        {
          "name": "Gateway Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Auth Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/health",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "health"]
            }
          }
        },
        {
          "name": "Product Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product/health",
              "host": ["{{baseUrl}}"],
              "path": ["product", "health"]
            }
          }
        },
        {
          "name": "Cart Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart/health",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "health"]
            }
          }
        },
        {
          "name": "Order Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/order/health",
              "host": ["{{baseUrl}}"],
              "path": ["order", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Auth Service",
      "item": [
        {
          "name": "Register Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    if (data.user && data.user.id) {",
                  "        pm.collectionVariables.set('userId', data.user.id);",
                  "    }",
                  "    var cookieToken = pm.cookies.get('token');",
                  "    if (cookieToken) {",
                  "        pm.collectionVariables.set('token', cookieToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"username\": \"johndoe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password@123\",\n  \"role\": \"CUSTOMER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Register Seller",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var cookieToken = pm.cookies.get('token');",
                  "    if (cookieToken) {",
                  "        pm.collectionVariables.set('sellerToken', cookieToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Seller\",\n  \"username\": \"janeseller\",\n  \"email\": \"seller@example.com\",\n  \"password\": \"Password@123\",\n  \"role\": \"SELLER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    if (data.user && data.user.id) {",
                  "        pm.collectionVariables.set('userId', data.user.id);",
                  "    }",
                  "    var cookieToken = pm.cookies.get('token');",
                  "    if (cookieToken) {",
                  "        if (data.user && data.user.role === 'SELLER') {",
                  "            pm.collectionVariables.set('sellerToken', cookieToken);",
                  "        } else {",
                  "            pm.collectionVariables.set('token', cookieToken);",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Johnathan Doe\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/update",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "update"]
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"Password@123\",\n  \"newpassword\": \"NewPassword@456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/changePassword",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "changePassword"]
            }
          }
        },
        {
          "name": "Add Address",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tag\": \"home\",\n  \"pincode\": 110001,\n  \"city\": \"New Delhi\",\n  \"state\": \"Delhi\",\n  \"country\": \"India\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/address",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "address"]
            }
          }
        },
        {
          "name": "Find Address by Tag",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/address/:tag",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "address", ":tag"],
              "variable": [
                {
                  "key": "tag",
                  "value": "home"
                }
              ]
            }
          }
        },
        {
          "name": "Get Address by User and Tag (Internal/Direct)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/address/:user/:tag",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "address", ":user", ":tag"],
              "variable": [
                {
                  "key": "user",
                  "value": "{{userId}}"
                },
                {
                  "key": "tag",
                  "value": "home"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Address by Tag",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/address/:tag",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "address", ":tag"],
              "variable": [
                {
                  "key": "tag",
                  "value": "home"
                }
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Product Service",
      "item": [
        {
          "name": "Add Product (Seller only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    if (data.product && data.product._id) {",
                  "        pm.collectionVariables.set('productId', data.product._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Noise Cancelling Headphones\",\n  \"stock\": 50,\n  \"price\": 2999,\n  \"category\": [\"electronics\", \"audio\", \"wireless\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/product/add",
              "host": ["{{baseUrl}}"],
              "path": ["product", "add"]
            }
          }
        },
        {
          "name": "Find Product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product/find/product/:id",
              "host": ["{{baseUrl}}"],
              "path": ["product", "find", "product", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{productId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Find Products by Name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product/find/name/:name",
              "host": ["{{baseUrl}}"],
              "path": ["product", "find", "name", ":name"],
              "variable": [
                {
                  "key": "name",
                  "value": "Wireless Noise Cancelling Headphones"
                }
              ]
            }
          }
        },
        {
          "name": "Find Products by Category (Query Param)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product/find/category?category=electronics",
              "host": ["{{baseUrl}}"],
              "path": ["product", "find", "category"],
              "query": [
                {
                  "key": "category",
                  "value": "electronics"
                }
              ]
            }
          }
        },
        {
          "name": "Find Products by Seller (User ID)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product/find/user/:id",
              "host": ["{{baseUrl}}"],
              "path": ["product", "find", "user", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{userId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Update Product Stock (Seller only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 100\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/product/updateStock/:id",
              "host": ["{{baseUrl}}"],
              "path": ["product", "updateStock", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{productId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Update Product Price (Seller only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 2499\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/product/updatePrice/:id",
              "host": ["{{baseUrl}}"],
              "path": ["product", "updatePrice", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{productId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Reduce Stock (Internal / Atomic)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/product/reduceStock/:id",
              "host": ["{{baseUrl}}"],
              "path": ["product", "reduceStock", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{productId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Restore Stock (Internal / Atomic)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/product/restoreStock/:id",
              "host": ["{{baseUrl}}"],
              "path": ["product", "restoreStock", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{productId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Product (Seller only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Noise Cancelling Headphones\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/product/delete",
              "host": ["{{baseUrl}}"],
              "path": ["product", "delete"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Cart Service",
      "item": [
        {
          "name": "Add / Update Item in Cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{productId}}\",\n  \"amount\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cart/add",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "add"]
            }
          }
        },
        {
          "name": "Get User Cart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart/",
              "host": ["{{baseUrl}}"],
              "path": ["cart", ""]
            }
          }
        },
        {
          "name": "Remove Item from Cart by Product ID",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart/delete/:id",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "delete", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{productId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Clear Entire Cart",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart/deleteCart",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "deleteCart"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Order Service",
      "item": [
        {
          "name": "Checkout / Place Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    if (data.order && data.order._id) {",
                  "        pm.collectionVariables.set('orderId', data.order._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tag\": \"home\",\n  \"phone\": 9876543210\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/order/create",
              "host": ["{{baseUrl}}"],
              "path": ["order", "create"]
            }
          }
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/order/my-orders",
              "host": ["{{baseUrl}}"],
              "path": ["order", "my-orders"]
            }
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/order/:id",
              "host": ["{{baseUrl}}"],
              "path": ["order", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{orderId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/order/cancel/:id",
              "host": ["{{baseUrl}}"],
              "path": ["order", "cancel", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{orderId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Update Order Status (Admin/Seller)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SHIPPED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/order/status/:id",
              "host": ["{{baseUrl}}"],
              "path": ["order", "status", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{orderId}}"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
